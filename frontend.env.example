# ============================================================
# PharmaVision AI — Configuration Frontend ↔ Backend
# ============================================================
# Copie ce fichier dans ton projet frontend sous le nom :
#   .env  (Vite)  ou  .env.local  (Create React App)
# ============================================================

# URL de base de l'API REST
VITE_API_BASE_URL=http://localhost:8000

# URL WebSocket caméra (remplace {session_id} dynamiquement)
VITE_WS_CAMERA_URL=ws://localhost:8000/ws/camera

# URL WebSocket alertes
VITE_WS_ALERTS_URL=ws://localhost:8000/ws/alerts

# Intervalle de polling en ms (si WebSocket non utilisé)
VITE_POLLING_INTERVAL_MS=500
